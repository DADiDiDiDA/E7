{
    "interface_version": 2,
    "name": "MAA-E7",
    "description": "《第七史诗》自动化脚本 - 每日任务 + 圣域照料",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用第七史诗自动化助手",
    "version": "1.4.7",

    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],

    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],

    "task": [
        {
            "name": "🎮 进入游戏",
            "entry": "启动游戏",
            "default_check": true,
            "description": "启动并进入游戏",
            "option": ["启动模式"]
        },
        {
            "name": "🌿 圣域精灵之森照料",
            "entry": "圣域入口检测-圣域",
            "default_check": true,
            "description": "进入圣域照料精灵之森（点击企鹅/泉水/植物/照料）"
        },
        {
            "name": "📧 邮件奖励领取",
            "entry": "开始领取邮件奖励",
            "default_check": true,
            "description": "领取邮箱内所有奖励"
        },
        {
            "name": "🛒 商店购买每日物品",
            "entry": "进入商店界面",
            "default_check": true,
            "description": "只买每日免费礼包"
        },
        {
            "name": "⚔️ 刷体力",
            "entry": "进入战斗界面",
            "default_check": true,
            "description": "可自定义选择要刷取的讨伐副本；只刷地狱级难度！！！！",
            "option": ["讨伐关卡选择"]
        },
        {
            "name": "🏟️ 竞技场10次",
            "entry": "进入竞技场选择",
            "default_check": true,
            "description": "只刷人机竞技场，快速战斗次数和挑战次数不足时会退出"
        },
        {
            "name": "⚔️ 骑士团签到并请求资源",
            "entry": "点击主界面菜单选择",
            "default_check": true,
            "description": "只会请求经验精灵，不会赠送资源欧"
        },
        {
            "name": "🎁 领取活跃度奖励",
            "entry": "进入选择菜单前等待",
            "default_check": true,
            "description": "只会领取活跃度100时的奖励，未到100不会领取"
        },
        {
            "name": "🎪 活动奖励处理",
            "entry": "活动奖励开始",
            "default_check": true,
            "description": "自动检测并领取活动界面中的可领取奖励（周年每日20抽、xx日记、免费召唤使用、xx之路日常领取等，每项可单独开关）",
            "option": [
                "活动1-周年每日20抽",
                "活动2-xx日记",
                "活动3-免费召唤使用",
                "活动4-xx之路日常领取"
            ]
        },
        {
            "name": "⏹️ 退出游戏",
            "entry": "退出游戏",
            "default_check": true,
            "description": "其实没必要，直接使用设置里的\"任务完成后退出\"即可"
        }
    ],

    "option": {
        "讨伐关卡选择": {
            "type": "select",
            "label": "讨伐关卡选择",
            "description": "选择要自动刷取的讨伐副本",
            "default_case": "双足飞龙",
            "cases": [
                {
                    "name": "双足飞龙",
                    "label": "双足飞龙",
                    "description": "暴击/命中/速度",
                    "pipeline_override": {
                        "开始讨伐关卡选择": {
                            "next": ["选择双足飞龙关卡"]
                        }
                    }
                },
                {
                    "name": "魔像",
                    "label": "魔像",
                    "description": "攻击/生命/防御/守护",
                    "pipeline_override": {
                        "开始讨伐关卡选择": {
                            "next": ["选择魔像关卡"]
                        }
                    }
                },
                {
                    "name": "报丧妖",
                    "label": "报丧妖",
                    "description": "抵抗/吸血/爆伤/反击",
                    "pipeline_override": {
                        "开始讨伐关卡选择": {
                            "next": ["选择报丧妖关卡"]
                        }
                    }
                },
                {
                    "name": "阿吉玛纳克",
                    "label": "阿吉玛纳克",
                    "description": "夹攻/免疫/愤怒",
                    "pipeline_override": {
                        "开始讨伐关卡选择": {
                            "next": ["选择讨伐阿吉玛纳克关卡"]
                        }
                    }
                },
                {
                    "name": "卡戴斯",
                    "label": "卡戴斯",
                    "description": "憎恨/伤口/穿透/激流",
                    "pipeline_override": {
                        "开始讨伐关卡选择": {
                            "next": ["选择讨伐卡戴斯关卡"]
                        }
                    }
                }
            ]
        },
        "启动模式": {
            "type": "select",
            "label": "启动模式",
            "description": "选择进入游戏的方式",
            "default_case": "不启动游戏",
            "cases": [
                {
                    "name": "开始启动游戏",
                    "label": "🚀正常启动",
                    "description": "正常启动游戏客户端",
                    "pipeline_override": { "启动游戏": { "next": ["开始启动游戏"] } }
                },
                {
                    "name": "不启动游戏",
                    "label": "📋跳过启动",
                    "description": "不启动游戏，直接开始任务（适用于模拟器启动游戏）",
                    "pipeline_override": { "启动游戏": { "next": ["不需要启动游戏"] } }
                }
            ]
        },
        "活动1-周年每日20抽": {
            "type": "select",
            "label": "周年领取每日20抽",
            "description": "选择是否执行活动1：周年领取每日20抽。",
            "default_case": "开启",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启",
                    "description": "执行活动1：周年领取每日20抽",
                    "pipeline_override": {
                        "是否开启活动1-周年领取每日20抽": {
                            "next": ["开始活动1-活动1"]
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭",
                    "description": "跳过活动",
                    "pipeline_override": {
                        "是否开启活动1-周年领取每日20抽": {
                            "next": ["不开始活动1-活动1"]
                        }
                    }
                }
            ]
        },
        "活动2-xx日记": {
            "type": "select",
            "label": "活动：xx日记",
            "description": "是否执行活动2：xx日记",
            "default_case": "开启",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启",
                    "description": "执行活动：xx日记",
                    "pipeline_override": {
                        "是否开启活动2-xx日记": {
                            "next": ["开始活动2-活动2"]
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭",
                    "description": "跳过活动：xx日记",
                    "pipeline_override": {
                        "是否开启活动2-xx日记": {
                            "next": ["不开始活动2-活动2"]
                        }
                    }
                }
            ]
        },
        "活动3-免费召唤使用": {
            "type": "select",
            "label": "免费召唤使用",
            "description": "是否执行：免费召唤使用",
            "default_case": "开启",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启",
                    "description": "执行免费召唤使用",
                    "pipeline_override": {
                        "是否开启活动3-免费召唤使用": {
                            "next": ["开始活动3-使用免费召唤"]
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭",
                    "description": "跳过免费召唤使用",
                    "pipeline_override": {
                        "是否开启活动3-免费召唤使用": {
                            "next": ["不开始活动3-活动3"]
                        }
                    }
                }
            ]
        },
        "活动4-xx之路日常领取": {
            "type": "select",
            "label": "xx之路日常领取",
            "description": "是否执行活动4：xx之路日常领取（进入活动→任务→领取每日任务奖励）",
            "default_case": "开启",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启",
                    "description": "执行活动4：xx之路日常领取",
                    "pipeline_override": {
                        "是否开启活动4-xx之路日常领取": {
                            "next": ["开始活动4-xx之路日常领取"]
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭",
                    "description": "跳过活动：xx之路日常领取",
                    "pipeline_override": {
                        "是否开启活动4-xx之路日常领取": {
                            "next": ["不开始活动4-xx之路日常领取"]
                        }
                    }
                }
            ]
        }
    }
}